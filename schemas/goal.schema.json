{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.dev/schemas/goal.schema.json",
  "title": "AOS-1 Goal",
  "type": "object",
  "required": ["id", "title", "status", "success_criteria", "budget", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^.+$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "status": { "enum": ["draft", "active", "blocked", "achieved", "failed", "cancelled"] },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "met"],
        "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "met": { "type": "boolean" } }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_ticks": { "type": "integer", "minimum": 1 },
        "max_usd": { "type": "number", "minimum": 0 },
        "max_wall_clock_s": { "type": "number", "minimum": 1 }
      }
    },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
  }
}
