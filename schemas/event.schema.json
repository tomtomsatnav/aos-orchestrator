{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.dev/schemas/event.schema.json",
  "title": "AOS-1 Event",
  "type": "object",
  "required": ["ts", "seq", "type", "actor"],
  "properties": {
    "ts": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "seq": { "type": "integer", "minimum": 0 },
    "type": { "enum": [
      "goal.created", "goal.updated", "goal.achieved", "goal.blocked", "goal.cancelled",
      "task.created", "task.ready", "task.started", "task.completed", "task.failed", "task.stalled", "task.retried",
      "agent.spawned", "agent.errored",
      "heartbeat.tick", "heartbeat.skipped", "heartbeat.late", "heartbeat.dead",
      "budget.exceeded",
      "human.pause", "human.resume", "human.cancel", "human.note"
    ] },
    "actor": { "type": "string", "pattern": "^.+$" },
    "goal_id": { "type": ["string", "null"] },
    "task_id": { "type": ["string", "null"] },
    "data": { "type": "object" }
  }
}
